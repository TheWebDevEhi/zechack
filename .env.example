# Server Port (default 3001)
PORT=3001

# Network: testnet or mainnet
NETWORK=testnet

# Lightwalletd gRPC Server endpoint
LIGHTWALLETD_URL=https://testnet.zec.rocks:443

# Local SQLite fallback path (used when TURSO_DATABASE_URL is not set)
DB_PATH=./data/zecshield.db

# Turso Cloud Database (Optional - uncomment to enable Turso cloud persistence)
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Scanner timing & batch size
SYNC_INTERVAL_MS=10000
BATCH_SIZE=500

# Security & Authentication
# Master administrative API key for mutating routes (keys, webhooks, purge, simulation)
ADMIN_API_KEY=zc_admin_test_secret_key
# Read-only API key for telemetry & queries (optional)
# READ_API_KEY=zc_read_test_secret_key

# Database Encryption Key for credentials at rest (AES-256-GCM)
ENCRYPTION_KEY=zecshield_master_encryption_key_32_bytes!!

# Allow HTTP webhook destinations (Set to true in local dev; false in production for HTTPS enforcement)
ALLOW_HTTP_WEBHOOKS=false
