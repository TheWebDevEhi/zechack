# Server Port (default 3001)
PORT=3001

# Network: testnet or mainnet
NETWORK=testnet

# Lightwalletd gRPC Server endpoint
LIGHTWALLETD_URL=https://testnet.zec.rocks:443

# Local SQLite fallback path (used when TURSO_DATABASE_URL is not set)
DB_PATH=./data/zecshield.db

# Turso Cloud Database (Optional - uncomment to enable Turso cloud persistence)
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Scanner timing & batch size
SYNC_INTERVAL_MS=10000
BATCH_SIZE=500

# Security & Authentication
# Master administrative API key for mutating routes (keys, webhooks, purge, simulation)
# IMPORTANT: In production, generate a high-entropy secret (e.g. openssl rand -hex 24)
ADMIN_API_KEY=zc_admin_test_secret_key
# Read-only API key for telemetry & queries (optional)
# READ_API_KEY=zc_read_test_secret_key

# Database Encryption Key for credentials at rest (AES-256-GCM with HKDF)
# IMPORTANT: In production, generate a dedicated 32-byte secret (e.g. openssl rand -hex 32)
ENCRYPTION_KEY=zecshield_master_encryption_key_32_bytes!!

# Webhook Security Policies
# Set to true in local development; false in production to enforce strict HTTPS webhooks
ALLOW_HTTP_WEBHOOKS=false
# Set to true only in localized unit testing to permit localhost webhook URLs
ALLOW_LOCALHOST_WEBHOOKS=false

# Network & Reverse Proxy (Optional)
# Whitelisted CORS origins (comma-separated; defaults to localhost ports)
# CORS_ORIGIN=https://zecshield.example.com
# Set to 1 or true if running behind reverse proxy / load balancer (Nginx, AWS ALB, Cloudflare)
# TRUST_PROXY=1
