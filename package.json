{
  "name": "zecshield",
  "version": "0.1.0",
  "description": "Developer-first Shielded Indexer & Webhook Gateway for Zcash",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build:dashboard": "npm --prefix dashboard install --include=dev && npm --prefix dashboard run build",
    "build": "npm run build:dashboard",
    "db:reset": "tsx scripts/reset-db.ts",
    "test:api": "tsx scripts/test-api.ts",
    "test:webhook": "tsx scripts/test-webhook-live.ts",
    "test:grpc": "tsx scripts/test-grpc.ts"
  },
  "keywords": [
    "zcash",
    "shielded",
    "indexer",
    "webhooks",
    "orchard",
    "sapling",
    "lightwalletd"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@elemental-zcash/zaddr_wasm_parser": "^0.2.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@ledgerhq/zcash-decrypt": "^0.2.0",
    "@ledgerhq/zcash-shielded": "^0.10.0",
    "@ledgerhq/zcash-utils": "^2.7.0",
    "@libsql/client": "^0.18.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "bech32": "^2.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "sql.js": "^1.15.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}